{
  "name": "savesort",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src tests supabase docs package.json tsconfig.json next.config.ts postcss.config.mjs eslint.config.mjs vitest.config.ts README.md AGENTS.md",
    "format:check": "prettier --check src tests supabase docs package.json tsconfig.json next.config.ts postcss.config.mjs eslint.config.mjs vitest.config.ts README.md AGENTS.md"
  },
  "dependencies": {
    "@google/genai": "2.17.1",
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "fflate": "0.8.3",
    "gsap": "^3.15.0",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "supabase": "2.114.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
