# Public Supabase values from the project Connect dialog
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used for email confirmation redirects and deployment URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only semantic embeddings (create a fresh key in Google AI Studio)
GEMINI_API_KEY=

# Optional server-only token for higher public GitHub API limits
GITHUB_TOKEN=

# Server-only GitHub OAuth and encrypted connection credentials
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=

# Server-only Reddit OAuth and encrypted connection credentials.
# Reddit requires a unique descriptive User-Agent on every Data API request.
REDDIT_APP_CLIENT_ID=
REDDIT_APP_CLIENT_SECRET=
REDDIT_TOKEN_ENCRYPTION_KEY=
REDDIT_USER_AGENT=web:savesort:v0.1 (by /u/your_reddit_username)

# Server-only YouTube (Google) OAuth and encrypted connection credentials.
# Scope is youtube.readonly only; SaveSort never writes to a YouTube account.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_TOKEN_ENCRYPTION_KEY=
# Optional: the multimodal model used to describe videos. Leave unset for the default.
GEMINI_YOUTUBE_MODEL=

SUPABASE_SECRET_KEY=
